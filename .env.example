# ==============================================================================
# AniWaveX (serene-hertz) Environment Configuration Template
# Copy this file to .env.local and configure your environment variables.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (Authentication, Bookmarks, Reading/Watch History)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Metadata Providers (TMDB)
# ------------------------------------------------------------------------------
TMDB_API_KEY=your-tmdb-api-key
TMDB_READ_TOKEN=your-tmdb-read-access-token

# ------------------------------------------------------------------------------
# Streaming & Edge Proxy Workers
# ------------------------------------------------------------------------------
NEXT_PUBLIC_STREAM_API_URL=https://your-stream-api.workers.dev
NEXT_PUBLIC_PROXY_URL=https://your-proxy-api.workers.dev
HINDI_STREAM_API_URL=https://your-hindi-worker.workers.dev
PROXY_SECRET=your-internal-hmac-proxy-secret

# ------------------------------------------------------------------------------
# Manga Worker & APIs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MANGA_WORKER_URL=https://your-manga-worker.workers.dev
MANGA_API_URL=https://api.mangadex.org

# ------------------------------------------------------------------------------
# OAuth & Library Sync (AniList & MyAnimeList)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_ANILIST_CLIENT_ID=your-anilist-client-id
ANILIST_CLIENT_SECRET=your-anilist-client-secret
NEXT_PUBLIC_MAL_CLIENT_ID=your-mal-client-id
MAL_CLIENT_SECRET=your-mal-client-secret

# ------------------------------------------------------------------------------
# Administration & Access Control
# ------------------------------------------------------------------------------
ADMIN_EMAILS=admin@example.com
NEXT_PUBLIC_ADMIN_EMAILS=admin@example.com

# ------------------------------------------------------------------------------
# Optional: Distributed Cache (Upstash Redis or Cloudflare KV)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=
